{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recurring-expenses",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 45
    }
  },
  "env": {
    "DATA_BACKEND": "dynamodb",
    "NEXT_PUBLIC_FIREBASE_DATABASE_ID": "(default)",
    "DYNAMODB_TABLE": "doosplit",
    "DYNAMODB_MIGRATION_TABLE": "doosplit_migration",
    "DYNAMODB_LOCKS_TABLE": "doosplit_locks",
    "AWS_REGION": "eu-central-1"
  }
}
